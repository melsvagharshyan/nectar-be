# "production" marks the session cookie as Secure (HTTPS only).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/nectar
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5180
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Admin sessions expire sooner than broker/partner ones.
ADMIN_JWT_EXPIRES_IN=12h
# Initial admin account, created by `npm run admin:create` (skipped if the email already exists).
# Password must be 8 to 128 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-strong-password
# Set when running behind a reverse proxy (e.g. 1 = one hop), so rate limits see the real client IP.
# TRUST_PROXY=1
# For local Playwright runs use TRUST_PROXY=loopback: each test sends its own X-Forwarded-For
# so the sign-in/sign-up rate limit applies per test.
# Property photos are stored in Cloudinary (Dashboard → API Keys).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional folder for uploaded photos.
CLOUDINARY_FOLDER=nectar/properties
