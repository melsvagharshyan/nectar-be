# "production" marks the session cookie as Secure (HTTPS only).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/nectar
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Required to sign up with the admin role.
ADMIN_SIGNUP_CODE=change-me
# Property photos are stored in Cloudinary (Dashboard → API Keys).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Optional folder for uploaded photos.
CLOUDINARY_FOLDER=nectar/properties
